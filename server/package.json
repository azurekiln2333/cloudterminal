{
  "name": "cloudterminal-server",
  "version": "0.1.0",
  "private": true,
  "description": "PC agent for the CloudTerminal remote desktop terminal and Claude Code console, including the in-process LAN relay",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "agent": "node src/agent/main.ts",
    "check": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "e2e": "node scripts/e2e.ts",
    "demo": "node scripts/demo-agent.ts",
    "sync-relay": "node scripts/sync-relay.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "node-pty": "1.1.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
