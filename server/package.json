{
  "name": "cloudterminal-server",
  "version": "0.1.0",
  "private": true,
  "description": "Relay server and PC agent for the CloudTerminal remote desktop terminal and Claude Code console",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "relay": "node src/relay/main.ts",
    "agent": "node src/agent/main.ts",
    "check": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "e2e": "node scripts/e2e.ts",
    "demo": "node scripts/demo-agent.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "mysql2": "3.15.3",
    "node-pty": "1.1.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
